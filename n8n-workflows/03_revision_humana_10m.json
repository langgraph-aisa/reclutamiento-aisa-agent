      "typeVersion": 2.2,
      "position": [
        500,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE applications SET review_hold_until = now() + interval '10 minutes', updated_at=now() WHERE id={{ $json.applicationId }} AND status='calificado' RETURNING id,status,review_hold_until;",
        "options": {}
      },
      "id": "guardar-ventana-de-revisión",
      "name": "Guardar ventana de revisión",
