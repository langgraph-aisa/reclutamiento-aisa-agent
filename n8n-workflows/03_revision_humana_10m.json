          "id": "PENDIENTE",
          "name": "PostgreSQL reclutamiento"
        }
      }
    },
    {
      "parameters": {
        "resume": "timeInterval",
        "amount": 10,
        "unit": "minutes"
      },
      "id": "esperar-10-minutos",
      "name": "Esperar 10 minutos",
