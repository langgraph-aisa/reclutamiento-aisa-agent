    {
      "parameters": {
        "jsCode": "if (!$json.applicationId || $json.status !== 'calificado' || $json.actorType !== 'human') return [{ json: { ...$json, skipped: true } }];\nreturn [{ json: { ...$json, holdUntil: new Date(Date.now() + 10 * 60 * 1000).toISOString() } }];"
      },
      "id": "validar-cambio",
      "name": "Validar cambio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.skipped ?? false }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "¿debe-esperar?",
      "name": "¿Debe esperar?",
